<?xml version="1.0" encoding="utf-8"?>
<!-- The blue behind the adaptive icon, sampled from the desktop build's mark
     (#5997F2 down to #264C97). The foreground art has transparent corners, so a
     flat white here would show as pale wedges once the launcher masks it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="270"
        android:startColor="#5997F2"
        android:endColor="#264C97" />
</shape>
